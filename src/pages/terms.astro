---
/**
 * Website Terms of Service — governed by the laws of India.
 * These cover use of the website and enquiries. Products and client projects
 * are governed by their own agreements (section 5).
 */
import LegalLayout from "../layouts/LegalLayout.astro";
import { site } from "../data/site";

const updated = "7 October 2026";
const sections = [
  { id: "agreement", title: "Agreement to these terms" },
  { id: "about", title: "About Reofex" },
  { id: "use", title: "Using this website" },
  { id: "acceptable-use", title: "Acceptable use" },
  { id: "products-services", title: "Products and client work" },
  { id: "enquiries", title: "Enquiries and proposals" },
  { id: "ip", title: "Intellectual property" },
  { id: "third-party", title: "Third-party links and services" },
  { id: "disclaimer", title: "Disclaimer" },
  { id: "liability", title: "Limitation of liability" },
  { id: "indemnity", title: "Indemnity" },
  { id: "privacy", title: "Privacy" },
  { id: "changes", title: "Changes" },
  { id: "law", title: "Governing law and disputes" },
  { id: "general", title: "General" },
  { id: "contact", title: "Contact" },
];
const mail = `mailto:${site.email}`;
---

<LegalLayout
  title="Terms of Service"
  description="The terms that apply when you use the Reofex Technologies website and contact us about our products and services."
  updated={updated}
  intro="The terms that apply when you use this website and get in touch with us. Our products and client projects have their own agreements."
  sections={sections}
>
  <section id="agreement">
    <h2>1. Agreement to these terms</h2>
    <p>
      These Terms of Service ("Terms") apply to your use of this website and to the communications you have with us
      through it. By using the website, you agree to these Terms. If you don't agree, please don't use the website.
    </p>
    <p>
      If you use the website on behalf of an organisation, you confirm that you're authorised to accept these Terms for
      it.
    </p>
  </section>

  <section id="about">
    <h2>2. About Reofex</h2>
    <p>
      This website is operated by <strong>Reofex Technologies</strong> ("Reofex", "we", "us", "our"), a software company
      based in India. You can contact us at <a href={mail}>{site.email}</a>.
    </p>
  </section>

  <section id="use">
    <h2>3. Using this website</h2>
    <p>
      You may browse the website and use its content for your own information and to evaluate working with us. We may
      change, update, suspend or remove any part of the website at any time without notice, and we don't guarantee that
      it will always be available or free of errors.
    </p>
  </section>

  <section id="acceptable-use">
    <h2>4. Acceptable use</h2>
    <p>When using the website, you agree not to:</p>
    <ul>
      <li>break any applicable law, including the Information Technology Act, 2000;</li>
      <li>attempt to gain unauthorised access to the website, its servers or any connected system;</li>
      <li>introduce viruses, malware or any harmful code, or interfere with the website's operation or security;</li>
      <li>use automated tools to scrape, copy or overload the website, other than standard search-engine indexing;</li>
      <li>send spam, unsolicited promotions or misleading information through our contact channels;</li>
      <li>impersonate any person or organisation, or misrepresent your affiliation with them;</li>
      <li>use the website or its content to build a competing product or to mislead others about Reofex.</li>
    </ul>
  </section>

  <section id="products-services">
    <h2>5. Products and client work</h2>
    <p>
      This website describes our products — Respondly, Reofex Growth, Reofex Sync and Fynex — and our services. These
      descriptions are for general information and are not an offer or a binding commitment.
    </p>
    <ul>
      <li>
        <strong>Products</strong> are provided under their own terms of service, subscription or licence agreements,
        which you accept when you sign up for or buy them. Features, pricing and availability are set out there and may
        change.
      </li>
      <li>
        <strong>Custom software, development and IT services</strong> are provided only under a separate written
        agreement (such as a proposal, statement of work or master services agreement) signed by both parties.
      </li>
    </ul>
    <p>If those agreements conflict with these Terms, those agreements take priority for the product or service they cover.</p>
  </section>

  <section id="enquiries">
    <h2>6. Enquiries and proposals</h2>
    <p>
      Contacting us through the website, by email or on WhatsApp doesn't create a client relationship or oblige either of
      us to enter into one. Estimates, timelines and proposals we share are non-binding until they're agreed in writing.
    </p>
    <p>
      Please don't share confidential information or sensitive personal data in an initial enquiry. If a discussion
      needs it, we're happy to sign a non-disclosure agreement first.
    </p>
  </section>

  <section id="ip">
    <h2>7. Intellectual property</h2>
    <p>
      The website and its content — including text, design, graphics, product illustrations and screenshots, and code —
      are owned by or licensed to Reofex and protected by intellectual property laws.
    </p>
    <p>
      "Reofex", "Reofex Technologies", "Respondly", "Reofex Growth", "Reofex Sync", "Fynex" and their logos are names and
      brands of Reofex. You may not use them without our prior written permission, except to refer to us accurately.
    </p>
    <p>
      Other names and marks mentioned on the website, such as WhatsApp, Instagram, Facebook, Meta, Zoho and Razorpay,
      belong to their respective owners. Their mention describes integrations or channels and doesn't imply endorsement
      or partnership.
    </p>
  </section>

  <section id="third-party">
    <h2>8. Third-party links and services</h2>
    <p>
      The website links to third-party sites and services, including our product websites, WhatsApp and our social
      media profiles. When you follow those links, the third party's own terms and privacy policy apply, and we're not
      responsible for their content or practices.
    </p>
  </section>

  <section id="disclaimer">
    <h2>9. Disclaimer</h2>
    <p>
      The website and its content are provided "as is" and "as available". To the fullest extent permitted by law, we
      make no warranties of any kind about the website, including warranties of accuracy, completeness, availability,
      fitness for a particular purpose or non-infringement. Content on the website is general information and isn't
      professional, legal or financial advice.
    </p>
  </section>

  <section id="liability">
    <h2>10. Limitation of liability</h2>
    <p>
      To the fullest extent permitted by applicable law, Reofex will not be liable for any indirect, incidental,
      special, consequential or punitive loss, or for loss of profits, revenue, data or goodwill, arising from your use
      of — or inability to use — the website or its content.
    </p>
    <p>
      Nothing in these Terms limits liability that cannot be limited under applicable law. Liability relating to our
      products or client work is governed by the agreements described in <a href="#products-services">section 5</a>.
    </p>
  </section>

  <section id="indemnity">
    <h2>11. Indemnity</h2>
    <p>
      You agree to compensate Reofex for any loss, claim or expense (including reasonable legal fees) that results from
      your breach of these Terms or your misuse of the website.
    </p>
  </section>

  <section id="privacy">
    <h2>12. Privacy</h2>
    <p>
      How we handle personal data is explained in our <a href="/privacy">Privacy Policy</a>, which forms part of these
      Terms.
    </p>
  </section>

  <section id="changes">
    <h2>13. Changes</h2>
    <p>
      We may update these Terms from time to time. The "Last updated" date at the top shows when they were last revised.
      Continuing to use the website after a change means you accept the updated Terms.
    </p>
  </section>

  <section id="law">
    <h2>14. Governing law and disputes</h2>
    <p>
      These Terms are governed by the laws of India. We'd always rather resolve concerns directly — please contact us
      first. Any dispute that can't be resolved informally will be subject to the exclusive jurisdiction of the
      competent courts in India.
    </p>
  </section>

  <section id="general">
    <h2>15. General</h2>
    <ul>
      <li>If any part of these Terms is found unenforceable, the rest remains in effect.</li>
      <li>If we don't enforce a right under these Terms straight away, we haven't waived it.</li>
      <li>You may not transfer your rights under these Terms. We may transfer ours, for example as part of a business reorganisation.</li>
      <li>These Terms, together with our Privacy Policy, are the entire agreement between you and us about the website.</li>
    </ul>
  </section>

  <section id="contact">
    <h2>16. Contact</h2>
    <p>Questions about these Terms? We're happy to help.</p>
    <p class="lg__note">
      <strong>Reofex Technologies</strong><br />
      Email: <a href={mail}>{site.email}</a>
    </p>
  </section>
</LegalLayout>
