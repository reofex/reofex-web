---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <PageHero eyebrow="404" title="This page didn't" titleAccent="make it to production." lead="The link may be broken or the page may have moved.">
    <Button href="/">Back to home</Button>
  </PageHero>
</BaseLayout>
