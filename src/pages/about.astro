---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import ProductIcon from "../components/ui/ProductIcon.astro";
import Icon from "../components/ui/Icon.astro";
import CTASection from "../components/home/CTASection.astro";
import { products, productHref } from "../data/products";
import { services } from "../data/site";

const values = [
  { title: "Clarity", body: "Plain answers on scope, cost and timelines before any work starts." },
  { title: "Ownership", body: "We treat every system we build as if we have to run it ourselves — because often we do." },
  { title: "Practical AI", body: "AI does the reading and drafting. A person approves anything that involves money or a customer." },
  { title: "Built to run", body: "Testing, monitoring and documentation are part of the build, because we support what we ship." },
];
---

<BaseLayout
  title="About"
  description="Reofex Technologies is a software company that builds SaaS products, intelligent automation and custom software for modern businesses."
>
  <PageHero
    crumbs={[{ label: "About" }]}
    title="A software company that builds"
    titleAccent="real products."
    lead="We build and run four products of our own: Respondly, Reofex Sync, Reofex Growth and Fynex. We also build custom software for other businesses, with the same team and the same process."
  />

  <section class="section section--white" aria-labelledby="story-title">
    <div class="container ab">
      <div class="ab__copy" data-reveal>
        <h2 class="h2" id="story-title">Products and engineering, under one roof.</h2>
        <p class="lead">
          We design, build and run our own products — and we bring that same product thinking and engineering discipline
          to the businesses we build for.
        </p>
        <p class="muted">
          Building products ourselves keeps us honest: we know what it takes to take software from idea to production, and
          to keep it running and improving afterwards.
        </p>
        <!-- TODO: add founding story, team and location once confirmed by Reofex. -->
      </div>
      <div class="ab__cards" data-reveal>
        <div class="ab__card">
          <p class="ab__label">Products</p>
          <ul role="list">
            {
              products.map((p) => (
                <li>
                  <a href={productHref(p.slug)}>
                    <ProductIcon product={p} size={28} />
                    {p.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ab__card ab__card--dark">
          <p class="ab__label">Engineering services</p>
          <ul role="list">
            {
              services.map((s) => (
                <li>
                  <a href={`/solutions#${s.slug}`}>
                    <Icon name={s.icon} size={18} />
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="values-title">
    <div class="container">
      <SectionHeader id="values-title" title="How we work." />
      <ul role="list" class="vl">
        {
          values.map((v, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .ab {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .ab__copy {
    display: grid;
    gap: var(--space-5);
  }
  .ab__cards {
    display: grid;
    gap: var(--space-4);
  }
  .ab__card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--reofex-cream);
    border: 1px solid var(--reofex-border);
  }
  .ab__card--dark {
    background: var(--reofex-dark);
    color: #fff;
    border-color: transparent;
  }
  .ab__label {
    margin-bottom: var(--space-4);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--reofex-orange-ink);
  }
  .ab__card--dark .ab__label {
    color: var(--reofex-orange);
  }
  .ab__card ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .ab__card a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
  }
  .ab__card a:hover {
    color: var(--reofex-orange-ink);
  }
  .ab__card--dark a:hover {
    color: var(--reofex-orange);
  }
  .ab__card--dark :global(.icon) {
    color: var(--reofex-orange);
  }
  .vl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }
  .vl li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-6);
    border-top: 2px solid var(--reofex-dark);
  }
  .vl span {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--reofex-orange-ink);
  }
  .vl h3 {
    font-size: 1.125rem;
  }
  .vl p {
    font-size: var(--fs-sm);
    color: var(--reofex-muted);
  }
  @media (max-width: 1023px) {
    .ab {
      grid-template-columns: 1fr;
    }
    .vl {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .vl,
    .ab__card ul {
      grid-template-columns: 1fr;
    }
  }
</style>
