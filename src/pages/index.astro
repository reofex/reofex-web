---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import ProductGrid from "../components/home/ProductGrid.astro";
import ServicesGrid from "../components/home/ServicesGrid.astro";
import ProcessTimeline from "../components/home/ProcessTimeline.astro";
import CaseStudySection from "../components/casestudy/CaseStudySection.astro";
import CTASection from "../components/home/CTASection.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Reofex Technologies — Software products, AI & custom software"
  rawTitle
  description={site.description}
  jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.url }}
>
  <Hero />
  <ProductGrid />
  <ServicesGrid />
  <ProcessTimeline />
  <CaseStudySection />
  <CTASection />
</BaseLayout>
