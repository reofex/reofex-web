---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ServicesGrid from "../components/home/ServicesGrid.astro";
import ProcessTimeline from "../components/home/ProcessTimeline.astro";
// Case studies hidden until approved content is ready.
// import CaseStudySection from "../components/casestudy/CaseStudySection.astro";
import CTASection from "../components/home/CTASection.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Reofex Technologies — Software products, AI & custom software"
  rawTitle
  description={site.description}
  jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.url }}
>
  <HomeHero />
  <ServicesGrid />
  <ProcessTimeline />
  {/* <CaseStudySection /> — hidden until approved case studies are ready */}
  <CTASection />
</BaseLayout>
