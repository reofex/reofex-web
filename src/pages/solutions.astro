---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Button from "../components/ui/Button.astro";
import ServiceStory from "../components/solutions/ServiceStory.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import CTASection from "../components/home/CTASection.astro";

const models = [
  { title: "Project delivery", body: "A defined scope, built end-to-end by Reofex, usually live in about four weeks." },
  { title: "Product partnership", body: "We act as your product and engineering team while you focus on the business." },
  { title: "Team extension", body: "Experienced engineers join your team and work inside your process." },
];
---

<BaseLayout
  title="Solutions — Custom software, SaaS, AI & automation"
  description="Reofex builds custom software, SaaS products, AI & automation, integrations and provides development assistance and IT solutions — focused on business outcomes."
>
  <PageHero
    crumbs={[{ label: "Solutions" }]}
    title="Software for your business,"
    titleAccent="built like our own products."
    lead="The same team that builds Reofex products builds software for other businesses — custom applications, SaaS platforms, automation and integrations."
  >
    <Button href="/contact?topic=project" size="lg">Start a project</Button>
  </PageHero>

  <ServiceStory />

  <section class="section" aria-labelledby="models-title">
    <div class="container">
      <SectionHeader id="models-title" title="Engagements that fit the problem." align="split" lead="Every engagement follows the same disciplined process — what changes is how we plug into your team." />
      <ol role="list" class="em">
        {
          models.map((m, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="em__link"><Button href="/how-we-build" variant="ghost">See how we build</Button></p>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .em {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  /* same open, ruled columns as the products page principles */
  .em li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-6);
    border-top: 2px solid var(--reofex-dark);
  }
  .em span {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--reofex-orange-ink);
  }
  .em h3 {
    font-size: 1.25rem;
  }
  .em p {
    color: var(--reofex-muted);
  }
  .em__link {
    margin-top: var(--space-8);
  }
  @media (max-width: 900px) {
    .em {
      grid-template-columns: 1fr;
    }
    .em li {
      padding-top: var(--space-5);
    }
  }
</style>
