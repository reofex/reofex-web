---
import Icon from "../ui/Icon.astro";
import ProductIcon from "../ui/ProductIcon.astro";
import ProductMiniUI from "../visuals/ProductMiniUI.astro";
import { productHref, type Product } from "../../data/products";

interface Props {
  product: Product;
  index?: number;
  headingLevel?: "h3" | "h2";
}
const { product: p, index = 0, headingLevel: H = "h3" } = Astro.props;
---

<article class="pc" style={`--acc:${p.accent};--reveal-i:${index}`} data-reveal>
  <div class="pc__head">
    <ProductIcon product={p} size={44} />
    <div class="pc__titles">
      <H class="pc__name">
        <a href={productHref(p.slug)} class="pc__link">{p.name}</a>
      </H>
      <p class="pc__cat">{p.category}</p>
    </div>
    <Icon name="chevronRight" size={20} class="pc__chev" />
  </div>
  <p class="pc__tagline">{p.tagline}</p>
  <div class="pc__visual">
    <ProductMiniUI product={p.slug} />
  </div>
  <span class="pc__more" aria-hidden="true">Learn more <Icon name="arrowRight" size={16} /></span>
</article>

<style>
  .pc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 70% at 100% 100%, color-mix(in srgb, var(--acc) 10%, transparent), transparent 60%),
      var(--reofex-white);
    border: 1px solid var(--reofex-border);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .pc:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--acc) 35%, var(--reofex-border));
  }
  .pc:focus-within {
    border-color: var(--acc);
  }
  .pc__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .pc__titles {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .pc__name {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  /* Stretched link: whole card is clickable, one tab stop */
  .pc__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .pc__link:focus-visible {
    outline: none;
  }
  .pc:has(.pc__link:focus-visible) {
    outline: 2px solid var(--reofex-orange);
    outline-offset: 3px;
  }
  .pc__cat {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--acc) 70%, black);
  }
  .pc__tagline {
    color: var(--reofex-muted);
    max-width: 40ch;
  }
  .pc :global(.pc__chev) {
    display: none;
    color: var(--reofex-muted);
  }
  .pc__visual {
    margin-top: auto;
    padding-top: var(--space-2);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .pc:hover .pc__visual {
    transform: translateY(-3px);
  }
  .pc__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--reofex-orange-ink);
  }
  .pc__more :global(.icon) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pc:hover .pc__more :global(.icon) {
    transform: translateX(4px);
  }

  /* Mobile: compact, scannable row */
  @media (max-width: 767px) {
    .pc {
      gap: var(--space-2);
      padding: var(--space-5);
      border-radius: var(--radius-lg);
    }
    .pc:hover {
      transform: none;
    }
    .pc :global(.pc__chev) {
      display: block;
    }
    .pc__tagline {
      font-size: var(--fs-sm);
      padding-left: calc(44px + var(--space-4));
    }
    .pc__visual,
    .pc__more {
      display: none;
    }
  }
</style>
