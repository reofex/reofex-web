---
/**
 * Step-by-step workflow. Steps that involve human approval are highlighted,
 * keeping "human in control" visible wherever it applies.
 */
import Icon from "../ui/Icon.astro";

interface Props {
  steps: { label: string; detail?: string }[];
  accent?: string;
}
const { steps, accent = "var(--reofex-orange)" } = Astro.props;
const isHuman = (s: { label: string }) => /approv|review/i.test(s.label);
// Balanced desktop rows: up to 7 in one row, otherwise split evenly (9 → 5 + 4)
const cols = steps.length <= 7 ? steps.length : Math.ceil(steps.length / 2);
---

<ol class="wf" style={`--acc:${accent};--cols:${cols}`} data-wf>
  {
    steps.map((s, i) => (
      <li class:list={["wf__step", isHuman(s) && "is-human", (i + 1) % cols === 0 && "is-row-end"]} style={`--i:${i}`}>
        <span class="wf__dot">
          {isHuman(s) ? <Icon name="userCheck" size={16} /> : String(i + 1).padStart(2, "0")}
        </span>
        <span class="wf__text">
          <b>{s.label}</b>
          {s.detail && <small>{s.detail}</small>}
          {isHuman(s) && <em>Human approval</em>}
        </span>
      </li>
    ))
  }
</ol>

<script>
  document.querySelectorAll<HTMLElement>("[data-wf]").forEach((el) => {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          el.classList.add("is-active");
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  });
</script>

<style>
  .wf {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-3);
    counter-reset: wf;
  }
  .wf__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--reofex-white);
    border: 1px solid var(--line);
    opacity: 0.001;
    transform: translateY(10px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }
  :global(.section--dark) .wf__step {
    background: rgb(255 255 255 / 0.04);
  }
  :global(html:not(.js)) .wf__step,
  .wf.is-active .wf__step {
    opacity: 1;
    transform: none;
  }
  /* connector arrow */
  .wf__step:not(:last-child)::after {
    content: "";
    position: absolute;
    z-index: 1;
    top: 50%;
    right: calc(var(--space-3) * -0.5 - 5px);
    width: 10px;
    height: 10px;
    border-top: 1.5px solid var(--acc);
    border-right: 1.5px solid var(--acc);
    background: var(--reofex-cream);
    transform: translateY(-50%) rotate(45deg);
    opacity: 0.7;
  }
  :global(.section--dark) .wf__step:not(:last-child)::after,
  :global(.section--white) .wf__step:not(:last-child)::after {
    background: transparent;
  }
  .wf__dot {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--acc);
    background: color-mix(in srgb, var(--acc) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--acc) 40%, transparent);
  }
  .wf__text {
    display: grid;
    gap: 4px;
  }
  .wf__text b {
    font-size: 0.9375rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .wf__text small {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .wf__text em {
    justify-self: start;
    margin-top: 4px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    font-style: normal;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    background: rgb(247 141 32 / 0.14);
    color: var(--reofex-orange-ink);
  }
  :global(.section--dark) .wf__text em {
    color: var(--reofex-orange);
  }
  .wf__step.is-human {
    border-color: var(--reofex-orange);
    box-shadow: 0 0 0 3px rgb(247 141 32 / 0.12);
  }
  .wf__step.is-human .wf__dot {
    color: var(--reofex-dark);
    background: var(--reofex-orange);
    border-color: var(--reofex-orange);
  }

  @media (min-width: 1024px) {
    .wf__step.is-row-end::after {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    .wf {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
  }
  @media (max-width: 767px) {
    .wf {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .wf__step {
      grid-template-columns: 36px 1fr;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4);
    }
    .wf__step:not(:last-child)::after {
      top: auto;
      bottom: calc(var(--space-2) * -0.5 - 5px);
      right: auto;
      left: calc(var(--space-4) + 13px);
      transform: rotate(135deg);
    }
  }
</style>
