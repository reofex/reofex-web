---
import Icon from "../ui/Icon.astro";
import type { Feature } from "../../data/products";

interface Props {
  features: Feature[];
  accent?: string;
}
const { features, accent = "var(--reofex-orange)" } = Astro.props;
---

<ul role="list" class="fg" style={`--acc:${accent}`}>
  {
    features.map((f) => (
      <li class="fg__item">
        <h3 class="fg__title">
          <Icon name={f.icon} size={18} class="fg__icon" />
          {f.title}
        </h3>
        <p class="fg__body">{f.body}</p>
      </li>
    ))
  }
</ul>

<style>
  /* Open grid divided by hairlines: these aren't interactive, so no boxes or hover motion */
  .fg {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .fg__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--reofex-border);
  }
  .fg__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .fg__title :global(.fg__icon) {
    color: color-mix(in srgb, var(--acc) 85%, black);
  }
  .fg__body {
    font-size: var(--fs-sm);
    color: var(--reofex-muted);
    padding-left: calc(18px + var(--space-3));
  }
</style>
