---
import Button from "../ui/Button.astro";
import BackdropCurves from "../visuals/BackdropCurves.astro";
import { processSteps } from "../../data/site";

interface Props {
  showCta?: boolean;
  headingLevel?: "h1" | "h2";
}
const { showCta = true, headingLevel: H = "h2" } = Astro.props;
---

<section class="section section--dark pt" aria-labelledby="process-title">
  <BackdropCurves variant="process" />
  <div class="container container--wide pt__inner">
    <div class="pt__intro" data-reveal>
      <div class="pt__titles">
        <H class="h2" id="process-title">
          Seven steps,
          <br />
          from idea to production.
        </H>
      </div>
      <div class="pt__side">
        <p class="lead">
          The same process we use on our own products: understand the problem first, prove it with a prototype,
          and keep improving after launch.
        </p>
        {showCta && <Button href="/how-we-build" variant="secondary" icon="arrowRight">Our process</Button>}
      </div>
    </div>

    <ol class="pt__steps" data-steps>
      {
        processSteps.map((s, i) => (
          <li class="pt__step" style={`--i:${i}`}>
            <span class="pt__num">{s.n}</span>
            <h3 class="pt__title">{s.title}</h3>
            <p class="pt__body">{s.body}</p>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<script>
  // The rail fills with scroll and each step lights up as the rail reaches it.
  // Reduced motion / no IntersectionObserver: show the finished state.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-steps]").forEach((el) => {
    const steps = Array.from(el.querySelectorAll<HTMLElement>(".pt__step"));
    const finish = () => {
      el.style.setProperty("--p", "1");
      steps.forEach((s) => s.classList.add("is-lit"));
    };
    if (reduce) return finish();
    el.classList.add("is-scrub");

    let ticking = false;
    const update = () => {
      ticking = false;
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight;
      const vertical = window.matchMedia("(max-width: 899px)").matches;
      // horizontal rail: fill while the block travels from 85% → 45% of the viewport;
      // vertical rail: fill as the block scrolls past the middle of the screen
      const p = vertical
        ? (vh * 0.6 - r.top) / r.height
        : (vh * 0.85 - r.top) / (vh * 0.4);
      const prog = Math.max(0, Math.min(1, p));
      el.style.setProperty("--p", prog.toFixed(4));
      steps.forEach((s, i) => s.classList.toggle("is-lit", prog >= i / Math.max(1, steps.length - 1) - 0.02));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  });
</script>

<style>
  .pt {
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 0% 0%, rgb(26 66 74 / 0.7), transparent 70%),
      var(--reofex-dark);
  }
  .pt__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .pt__intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: var(--space-8);
  }
  .pt__titles,
  .pt__side {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .pt__steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-6);
    position: relative;
    align-self: start;
    padding-top: var(--space-2);
  }
  /* connecting rail */
  .pt__steps::before,
  .pt__steps::after {
    content: "";
    position: absolute;
    top: calc(var(--space-2) + 17px);
    left: 18px;
    right: 18px;
    height: 1px;
    background: var(--reofex-border-dark-strong);
  }
  .pt__steps::after {
    background: linear-gradient(90deg, var(--reofex-orange), rgb(247 141 32 / 0.3));
    transform-origin: left;
    transform: scaleX(var(--p, 0));
    transition: transform 1.6s var(--ease-out);
  }
  .pt__steps.is-scrub::after {
    transform: scaleX(var(--p, 0));
    transition: none;
  }
  .pt__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .pt__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    background: var(--reofex-dark);
    border: 1px solid var(--reofex-border-dark-strong);
    color: var(--reofex-muted-dark);
    transition:
      border-color var(--dur-slow) var(--ease-out),
      color var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }
  .is-lit .pt__num {
    border-color: var(--reofex-orange);
    color: var(--reofex-orange);
    box-shadow: 0 0 0 4px rgb(247 141 32 / 0.12);
  }
  .pt__title {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .pt__body {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--reofex-muted-dark);
  }

  @media (max-width: 899px) {
    .pt__intro {
      grid-template-columns: 1fr;
    }
  }
  /* Vertical timeline on mobile / small tablet */
  @media (max-width: 899px) {
    .pt__steps {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 0;
    }
    .pt__steps::before,
    .pt__steps::after {
      top: 18px;
      bottom: 18px;
      left: 18px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .pt__steps::after {
      background: linear-gradient(180deg, var(--reofex-orange), rgb(247 141 32 / 0.3));
      transform: scaleY(var(--p, 0));
      transform-origin: top;
    }
    .pt__steps.is-scrub::after {
      transform: scaleY(var(--p, 0));
    }
    .pt__step {
      grid-template-columns: 36px 1fr;
      column-gap: var(--space-5);
      row-gap: 2px;
      padding-bottom: var(--space-6);
    }
    .pt__step:last-child {
      padding-bottom: 0;
    }
    .pt__num {
      grid-row: span 2;
      margin: 0;
    }
    .pt__title {
      padding-top: 6px;
    }
  }
</style>
