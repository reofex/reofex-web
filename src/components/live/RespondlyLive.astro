    font-size: 0.85em;
  }
  .rl-card > p u {
    margin-left: auto;
    padding: 0.15em 0.6em;
    border-radius: 99px;
    background: #dcfce7;
    color: #008236;
    font-size: 0.85em;
    text-decoration: none;
    font-weight: 600;
  }
  .rl-quota {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
  }
  .rl-quota b {
    font-size: 3em;
    letter-spacing: -0.02em;
    border-radius: 0.2em;
  }
  .rl-quota small {
    font-size: 1.4em;
    color: var(--mut);
  }
  .rl-bar {
    height: 0.6em;
    border-radius: 99px;
    background: #eef0f4;
    overflow: hidden;
  }
  .rl-bar i {
    display: block;
    height: 100%;
    background: var(--ind);
  }
  .rl-note {
    font-size: 1.1em;
    color: var(--mut);
  }
  .rl-pill {
    margin-left: auto;
    padding: 0.15em 0.7em;
    border-radius: 99px;
    background: #dcfce7;
    color: #008236;
    font-size: 0.85em;
    font-weight: 600;
  }
  .rl-st {
    font-size: 1.25em;
  }
  .rl-wait {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--mut);
    font-size: 1.15em !important;
    font-weight: 600;
  }
  .rl-wait.is-hot {
    color: #e17100;
  }
  .rl-sold {
    display: flex;
    align-items: center;
    gap: 1.2em;
    padding: 1.3em 1.7em;
    border: 1px solid var(--line);
    border-radius: 1.2em;
    background: #fff;
    font-size: 1.3em;
  }
  .rl-sold > i {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 0.6em;
    background: #dcfce7;
    color: #008236;
  }
  .rl-sold span {
    color: var(--mut);
  }
  .rl-sold b {
