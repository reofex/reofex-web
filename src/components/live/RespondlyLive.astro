  }
  .rl-stats > div {
    position: relative;
    display: grid;
    gap: 0.3em;
    padding: 1.4em 1.6em;
    border: 1px solid var(--line);
    border-radius: 1.2em;
    background: #fff;
  }
  .rl-stats small {
    font-size: 1.05em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mut);
  }
  .rl-stats b {
    justify-self: start;
    font-size: 3em;
    letter-spacing: -0.02em;
    border-radius: 0.2em;
  }
  .rl-si {
    position: absolute;
    top: 1.2em;
    right: 1.2em;
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.7em;
    background: #f0edff;
    color: var(--ind);
  }
  .rl-si--o {
    background: #fff4e5;
    color: #e17100;
  }
  .rl-si--g {
    background: #f2f4f7;
    color: #475467;
  }
  .rl-si--b {
    background: #e8f1ff;
    color: #2563eb;
  }
  .rl-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6em;
  }
  .rl-ch small {
    margin-left: auto;
    font-size: 0.8em;
    color: var(--mut);
  }
  .rl-pipe__body {
    display: grid;
    grid-template-columns: 13em 1fr;
    align-items: center;
    gap: 2.4em;
    padding-top: 0.4em;
  }
  .rl-ring {
    position: relative;
  }
  .rl-ring svg {
    display: block;
    width: 100%;
  }
  .rl-ring span {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    line-height: 1.1;
  }
  .rl-ring b {
    font-size: 2.6em;
    border-radius: 0.2em;
  }
  .rl-ring small {
    font-size: 1.05em;
    color: var(--mut);
  }
  .rl-pipe ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75em;
  }
  .rl-pipe li {
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-size: 1.2em;
    color: #344054;
  }
