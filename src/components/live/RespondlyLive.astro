    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
  }
  .rl-pipe li b {
    margin-left: auto;
    color: var(--ink);
    border-radius: 0.2em;
  }
  .rl-sb {
    display: grid;
    grid-template-columns: 1fr auto 3.2em;
    align-items: baseline;
    gap: 0.3em 0.8em;
    font-size: 1.15em;
  }
  .rl-sb span {
    color: #344054;
  }
  .rl-sb b,
  .rl-sb small {
    text-align: right;
    border-radius: 0.2em;
  }
  .rl-sb small {
    color: var(--mut);
  }
  .rl-sb i {
    grid-column: 1 / -1;
    height: 0.5em;
    border-radius: 99px;
    background: #f2f4f7;
    overflow: hidden;
  }
  .rl-sb u {
    display: block;
    height: 100%;
    border-radius: 99px;
  }
  .rl-status {
    gap: 0.75em;
  }
  .rl-stats b.rl-job {
    font-size: 2.4em;
  }
  .rl-stats span {
    font-size: 1.1em;
    color: var(--mut);
  }
  .rl-ev {
    min-width: 40em;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9em;
    padding: 0.9em 1.2em;
    border-radius: 0.9em;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 1em 2.4em -1em rgb(16 24 40 / 0.35);
    font-size: 1.2em;
  }
  .rl-ev > i {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    color: #fff;
  }
  .rl-ev__wa {
    background: #25d366;
  }
  .rl-ev__ok {
    background: #00a63e;
  }
  .rl-ev__hot {
    background: #f78d20;
  }
  .rl-ev b {
    margin-right: 0.3em;
  }
  .rl-ev em {
    font-style: normal;
    font-weight: 600;
    color: var(--ind);
    border-radius: 0.3em;
  }
  .rl-ev--hot {
    border-color: #ffd6a7;
  }
  .rl-ev--hot em {
    color: #e17100;
  }

  @container (max-width: 560px) {
    .rl {
      grid-template-columns: 1fr;
      aspect-ratio: auto;
      font-size: calc(var(--u) * 3.4);
    }
    .rl-side,
    .rl-head > span,
    .rl-row3,
    .rl-stats,
    .rl-bottom {
      display: none !important;
    }
    .rl-head {
      min-height: 0;
    }
    .rl-ev {
      min-width: 0;
      width: 100%;
    }
    .rl-main {
      padding: 1.2em;
      gap: 1em;
    }
    .rl-sold {
      flex-wrap: wrap;
    }
  }
</style>
