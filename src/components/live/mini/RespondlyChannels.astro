---
/**
 * "Every channel, one assistant": one inbox, three channels, the online
 * store add-on. Product-style panel with demo data (Stride & Co.).
 */
import Icon from "../../ui/Icon.astro";

const rows = [
  { ch: "whatsapp", name: "Anjali M.", msg: "Brown boots in size 9?", state: "Replied in 4 s", tone: "wa" },
  { ch: "instagram", name: "@riya.k", msg: "Are the Chelsea boots back in size 7?", state: "Replied", tone: "ig" },
  { ch: "globe", name: "Website visitor", msg: "Do you deliver to Kakkanad?", state: "Replied", tone: "web" },
  { ch: "layers", name: "Online store", msg: "Order #1052 · Canvas Low-tops", state: "Paid ₹1,199", tone: "store" },
] as const;
---

<div class="rc">
  <div class="rc-head">
    <b>Conversations</b>
    <span class="rc-tabs"><i class="is-on">All</i><i>WhatsApp</i><i>Instagram</i><i>Web</i></span>
  </div>
  {
    rows.map((r) => (
      <div class="rc-row">
        <span class={`rc-ic rc-ic--${r.tone}`}>
          <Icon name={r.ch} size={13} />
        </span>
        <span class="rc-txt">
          <b>{r.name}</b>
          <small>{r.msg}</small>
        </span>
        <em class={r.tone === "store" ? "is-paid" : ""}>{r.state}</em>
      </div>
    ))
  }
  <div class="rc-foot"><i></i>One assistant · Stride & Co. · demo data</div>
</div>

<style>
  .rc {
    width: min(100%, 460px);
    border-radius: 14px;
    background: #fff;
    color: #101828;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.16),
      0 30px 60px -24px rgb(0 0 0 / 0.65);
  }
  .rc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 12px;
    border-bottom: 1px solid #eef0f3;
    font-size: 14px;
  }
  .rc-tabs {
    display: flex;
    gap: 4px;
  }
  .rc-tabs i {
    padding: 3px 8px;
    border-radius: 99px;
    font-style: normal;
    font-size: 11px;
    color: #667085;
    background: #f2f4f7;
  }
  .rc-tabs i.is-on {
    background: #4f39f6;
    color: #fff;
  }
  @media (max-width: 480px) {
    .rc-tabs i:nth-child(n + 3) {
      display: none;
    }
  }
  .rc-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid #f2f4f7;
  }
  .rc-ic {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
  }
  .rc-ic--wa {
    background: #25d366;
  }
  .rc-ic--ig {
    background: linear-gradient(135deg, #f58529, #dd2a7b 55%, #8134af);
  }
  .rc-ic--web {
    background: #2563eb;
  }
  .rc-ic--store {
    background: #4f39f6;
  }
  .rc-txt {
    display: grid;
    min-width: 0;
    line-height: 1.35;
    font-size: 13px;
  }
  .rc-txt small {
    color: #667085;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rc-row em {
    font-style: normal;
    font-size: 11.5px;
    font-weight: 600;
    color: #4f39f6;
    white-space: nowrap;
  }
  .rc-row em.is-paid {
    color: #008236;
  }
  .rc-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 11.5px;
    color: #667085;
    background: #f9fafb;
  }
  .rc-foot i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00c950;
  }
</style>
