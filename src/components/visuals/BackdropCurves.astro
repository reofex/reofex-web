---
/** Decorative orange/green curves used behind dark sections. */
interface Props {
  variant?: "hero" | "cta" | "process";
}
const { variant = "hero" } = Astro.props;
---

<div class:list={["bc", `bc--${variant}`]} aria-hidden="true">
  <svg viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id={`bc-o-${variant}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f78d20" stop-opacity="0" />
        <stop offset=".55" stop-color="#f78d20" stop-opacity=".55" />
        <stop offset="1" stop-color="#f78d20" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`bc-g-${variant}`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#2f8f86" stop-opacity="0" />
        <stop offset=".5" stop-color="#2f8f86" stop-opacity=".35" />
        <stop offset="1" stop-color="#2f8f86" stop-opacity="0" />
      </linearGradient>
      <pattern id={`bc-dots-${variant}`} width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="#fff" fill-opacity=".05" />
      </pattern>
    </defs>
    <rect width="1440" height="800" fill={`url(#bc-dots-${variant})`} />
    {
      variant === "hero" && (
        <>
          <path d="M-80 690C260 560 520 760 860 560 1120 410 1210 160 1520 120" stroke={`url(#bc-o-${variant})`} stroke-width="1.5" />
          <path d="M-60 760C300 650 640 820 980 640 1220 510 1330 330 1520 300" stroke={`url(#bc-g-${variant})`} stroke-width="1" />
        </>
      )
    }
    {
      variant === "cta" && (
        <>
          <path d="M-100 620C240 420 520 700 860 500 1100 360 1240 120 1540 80" stroke={`url(#bc-o-${variant})`} stroke-width="1.5" />
          <path d="M-100 160C220 300 520 60 820 220 1100 370 1260 620 1540 640" stroke={`url(#bc-g-${variant})`} stroke-width="1.2" />
        </>
      )
    }
    {
      variant === "process" && (
        <path d="M-80 120C300 260 620 40 960 180 1200 280 1320 460 1520 520" stroke={`url(#bc-g-${variant})`} stroke-width="1.2" />
      )
    }
  </svg>
</div>

<style>
  .bc {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .bc svg {
    width: 100%;
    height: 100%;
  }
  .bc--hero {
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
</style>
