---
/**
 * Hero composition: a central Reofex console with the four products
 * orbiting it. Pure HTML/CSS/SVG; scales as one unit via container units.
 */
import Icon from "../ui/Icon.astro";
import ProductIcon from "../ui/ProductIcon.astro";
import { products } from "../../data/products";
import markSvg from "../ui/logo-paths.svg?raw";

const events = [
  { slug: "respondly", text: "WhatsApp enquiry answered with your price list", state: "Replied" },
  { slug: "reofex-growth", text: "Campaign draft ready for your review", state: "Needs approval" },
  { slug: "reofex-sync", text: "Invoice validated, GST extracted, vendor matched", state: "To approve" },
  { slug: "fynex", text: "Visa renewal moved from HR to PRO", state: "In progress" },
] as const;
const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
const positions = ["tl", "tr", "bl", "br"];
---

<div class="eco" aria-hidden="true">
  <div class="eco__stage">
    <svg class="eco__orbits" viewBox="0 0 600 440" fill="none">
      <defs>
        <linearGradient id="eco-arc" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#f78d20" stop-opacity="0" />
          <stop offset=".5" stop-color="#f78d20" stop-opacity=".85" />
          <stop offset="1" stop-color="#f78d20" stop-opacity="0" />
        </linearGradient>
      </defs>
      <ellipse cx="300" cy="225" rx="292" ry="150" stroke="url(#eco-arc)" stroke-width="1.5" transform="rotate(-12 300 225)" />
      <ellipse cx="300" cy="225" rx="250" ry="190" stroke="rgb(255 255 255 / .08)" stroke-width="1" transform="rotate(18 300 225)" />
      <circle class="eco__spark" cx="22" cy="282" r="3.5" fill="#f78d20" />
    </svg>
    <div class="eco__glow"></div>

    <div class="eco__console">
      <div class="eco__bar">
        <span></span><span></span><span></span>
      </div>
      <div class="eco__app">
        <aside class="eco__side">
          <div class="eco__brand" set:html={markSvg} />
          <p class="eco__label">Products</p>
          {
            products.map((p, i) => (
              <div class:list={["eco__nav", i === 0 && "is-active"]} style={`--acc:${p.accent}`}>
                <i />
                {p.name}
              </div>
            ))
          }
        </aside>
        <div class="eco__main">
          <div class="eco__head">
            <div>
              <b>Activity</b>
              <small>Across your Reofex products</small>
            </div>
            <span class="eco__live"><i></i>Live</span>
          </div>
          <ul class="eco__feed">
            {
              events.map((e, i) => (
                <li style={`--acc:${bySlug[e.slug].accent};--i:${i}`}>
                  <ProductIcon product={bySlug[e.slug]} size={22} />
                  <div>
                    <b>{bySlug[e.slug].name}</b>
                    <span>{e.text}</span>
                  </div>
                  <em class:list={[e.state === "Needs approval" && "is-hot"]}>{e.state}</em>
                </li>
              ))
            }
          </ul>
          <div class="eco__flow">
            <span>Intake</span><i></i><span>AI</span><i></i><span class="is-human"><Icon name="userCheck" size={10} />Human approval</span><i></i><span>Systems</span>
          </div>
        </div>
      </div>
    </div>

    {
      products.map((p, i) => (
        <div class:list={["eco__chip", `eco__chip--${positions[i]}`]} style={`--acc:${p.accent};--i:${i}`}>
          <ProductIcon product={p} size={34} />
          <div>
            <b>{p.name}</b>
            <span>{p.category}</span>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .eco {
    container-type: inline-size;
    width: 100%;
  }
  .eco__stage {
    --u: calc(100cqi / 60); /* design grid: 60u wide */
    font-size: var(--u);
    position: relative;
    aspect-ratio: 60 / 44;
  }
  .eco__orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .eco__spark {
    filter: drop-shadow(0 0 6px #f78d20);
  }
  .eco__glow {
    position: absolute;
    inset: 15% 10%;
    background: radial-gradient(closest-side, rgb(247 141 32 / 0.22), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  /* ---- Console ---- */
  .eco__console {
    position: absolute;
    left: 9em;
    top: 6.5em;
    width: 42em;
    border-radius: 1.2em;
    background: #fff;
    color: var(--reofex-dark);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 3em 6em -2em rgb(0 0 0 / 0.6);
    overflow: hidden;
    animation: eco-rise 900ms var(--ease-out) both;
  }
  .eco__bar {
    display: flex;
    gap: 0.5em;
    padding: 0.9em 1.1em;
    background: #f7f5f0;
    border-bottom: 1px solid rgb(18 40 47 / 0.07);
  }
  .eco__bar span {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: rgb(18 40 47 / 0.14);
  }
  .eco__app {
    display: grid;
    grid-template-columns: 11em 1fr;
    min-height: 26em;
  }
  .eco__side {
    padding: 1.2em 0.9em;
    background: var(--reofex-dark);
    color: rgb(255 255 255 / 0.7);
    display: grid;
    align-content: start;
    gap: 0.35em;
    font-size: 0.95em;
  }
  .eco__brand {
    color: #fff;
    margin-bottom: 1.2em;
  }
  .eco__brand :global(svg) {
    width: 8em;
    height: auto;
  }
  .eco__label {
    font-size: 0.75em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
    margin-bottom: 0.3em;
  }
  .eco__nav {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.55em 0.6em;
    border-radius: 0.5em;
    font-weight: 600;
  }
  .eco__nav i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 0.2em;
    background: var(--acc);
  }
  .eco__nav.is-active {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }
  .eco__main {
    padding: 1.4em 1.5em;
    display: grid;
    align-content: start;
    gap: 1.1em;
  }
  .eco__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }
  .eco__head div {
    display: grid;
  }
  .eco__head b {
    font-size: 1.35em;
    letter-spacing: -0.02em;
  }
  .eco__head small {
    font-size: 0.9em;
    color: rgb(18 40 47 / 0.55);
  }
  .eco__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.7em;
    border-radius: 99px;
    font-size: 0.8em;
    font-weight: 700;
    background: rgb(31 157 107 / 0.1);
    color: #146a48;
  }
  .eco__live i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #1f9d6b;
    animation: eco-pulse 2s ease-in-out infinite;
  }
  .eco__feed {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55em;
  }
  .eco__feed li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8em;
    padding: 0.75em 0.9em;
    border-radius: 0.8em;
    border: 1px solid rgb(18 40 47 / 0.07);
    background: linear-gradient(90deg, color-mix(in srgb, var(--acc) 6%, white), #fff 40%);
    animation: eco-in 600ms var(--ease-out) both;
    animation-delay: calc(500ms + var(--i) * 140ms);
  }
  .eco__feed li :global(.picon) {
    --s: 2.4em !important;
  }
  .eco__feed li :global(.picon .icon) {
    width: 1.2em;
    height: 1.2em;
  }
  .eco__feed div {
    display: grid;
    font-size: 0.9em;
    min-width: 0;
  }
  .eco__feed div span {
    color: rgb(18 40 47 / 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eco__feed em {
    font-style: normal;
    font-size: 0.78em;
    font-weight: 700;
    padding: 0.3em 0.7em;
    border-radius: 99px;
    background: rgb(18 40 47 / 0.06);
    color: rgb(18 40 47 / 0.7);
    white-space: nowrap;
  }
  .eco__feed em.is-hot {
    background: rgb(247 141 32 / 0.16);
    color: #8a4700;
  }
  .eco__flow {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.8em 0.9em;
    border-radius: 0.8em;
    background: #f7f5f0;
    font-size: 0.8em;
    font-weight: 700;
    color: rgb(18 40 47 / 0.65);
  }
  .eco__flow i {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(90deg, rgb(18 40 47 / 0.3) 0 4px, transparent 4px 8px);
  }
  .eco__flow span {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .eco__flow .is-human {
    color: var(--reofex-dark);
    padding: 0.25em 0.6em;
    border-radius: 99px;
    background: #fff;
    box-shadow: 0 0 0 1.5px var(--reofex-orange);
  }
  .eco__flow :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  /* ---- Orbiting product chips ---- */
  .eco__chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.9em 1.3em 0.9em 0.9em;
    border-radius: 1em;
    background: rgb(20 46 54 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 1.5em 3em -1em rgb(0 0 0 / 0.5);
    color: #fff;
    animation:
      eco-in 700ms var(--ease-out) both,
      eco-float 7s ease-in-out infinite;
    animation-delay: calc(300ms + var(--i) * 120ms), calc(1.2s + var(--i) * 0.8s);
  }
  .eco__chip :global(.picon) {
    --s: 3.4em !important;
  }
  .eco__chip :global(.picon .icon) {
    width: 1.7em;
    height: 1.7em;
  }
  .eco__chip div {
    display: grid;
    line-height: 1.3;
  }
  .eco__chip b {
    font-size: 1.35em;
    letter-spacing: -0.01em;
  }
  .eco__chip span {
    font-size: 1em;
    color: rgb(255 255 255 / 0.62);
  }
  .eco__chip--tl { left: 1em; top: 1em; }
  .eco__chip--tr { right: 0; top: 2.5em; }
  .eco__chip--bl { left: 0; bottom: 4em; }
  .eco__chip--br { right: 1.5em; bottom: 0.5em; }

  @keyframes eco-rise {
    from { opacity: 0; transform: translateY(2em) scale(0.98); }
  }
  @keyframes eco-in {
    from { opacity: 0; transform: translateY(0.8em); }
  }
  @keyframes eco-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -0.5em; }
  }
  @keyframes eco-pulse {
    50% { opacity: 0.35; }
  }

  /* Narrow screens: dedicated compact layout on a 40u grid so text stays legible */
  @container (max-width: 520px) {
    .eco__stage {
      --u: calc(100cqi / 40);
      aspect-ratio: 40 / 42.5;
    }
    .eco__orbits {
      inset: -4% -30%;
      width: 160%;
    }
    .eco__console {
      left: 1em;
      top: 5.5em;
      width: 38em;
    }
    .eco__app {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .eco__side {
      display: none;
    }
    .eco__main {
      padding: 1.2em;
      gap: 0.9em;
    }
    .eco__feed div {
      font-size: 1em;
    }
    .eco__chip {
      padding: 0.7em 1em 0.7em 0.7em;
      gap: 0.6em;
    }
    .eco__chip span {
      display: none;
    }
    .eco__chip b {
      font-size: 1.3em;
    }
    .eco__chip :global(.picon) {
      --s: 2.8em !important;
    }
    .eco__chip :global(.picon .icon) {
      width: 1.4em;
      height: 1.4em;
    }
    .eco__chip--tl { left: 0; top: 0.5em; }
    .eco__chip--tr { right: 0; top: 1.5em; }
    .eco__chip--bl { left: 0; bottom: 0; }
    .eco__chip--br { right: 0; bottom: 1em; }
  }
</style>
