---
/** Dark hero used by inner pages. */
import BackdropCurves from "../visuals/BackdropCurves.astro";

interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  align?: "start" | "center";
  compact?: boolean;
}
const { eyebrow, title, titleAccent, lead, crumbs, align = "start", compact = false } = Astro.props;
---

<section class:list={["ph section--dark", `ph--${align}`, compact && "ph--compact"]} aria-labelledby="page-title" data-depth>
  <BackdropCurves variant="hero" />
  <div class="container ph__inner">
    {
      crumbs && (
        <nav aria-label="Breadcrumb" class="ph__crumbs">
          <ol role="list">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h1 ph__title" id="page-title">
      {title}
      {titleAccent && <span class="accent"> {titleAccent}</span>}
    </h1>
    {lead && <p class="lead ph__lead">{lead}</p>}
    <slot />
  </div>
  <slot name="after" />
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem));
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    /* The glow sits high and has fully faded before the bottom edge, so the hero ends on
       plain --reofex-dark: the colour every following section starts with. No seam. */
    background:
      radial-gradient(55% 60% at 88% 30%, rgb(26 66 74 / 0.9), transparent 70%),
      linear-gradient(180deg, var(--reofex-dark-2) 0%, var(--reofex-dark-2) 22%, var(--reofex-dark) 100%);
  }
  @media (max-width: 1023px) {
    .ph {
      background:
        radial-gradient(90% 50% at 90% 35%, rgb(26 66 74 / 0.9), transparent 70%),
        linear-gradient(180deg, var(--reofex-dark-2) 0%, var(--reofex-dark-2) 25%, var(--reofex-dark) 100%);
    }
  }
  .ph--compact {
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .ph__inner {
    position: relative;
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .ph--center .ph__inner {
    justify-items: center;
    text-align: center;
  }
  .ph__title {
    max-width: 18ch;
    font-size: clamp(2.375rem, 1.5rem + 3.2vw, 4rem);
  }
  .ph__lead {
    max-width: 60ch;
  }
  .ph__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--fs-sm);
    color: var(--reofex-muted-dark);
  }
  .ph__crumbs li + li::before {
    content: "/";
    margin-right: 6px;
    opacity: 0.5;
  }
  .ph__crumbs a:hover {
    color: var(--reofex-orange);
  }
  .ph__crumbs [aria-current] {
    color: #fff;
  }
</style>
