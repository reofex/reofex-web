---
import Icon from "./Icon.astro";
import type { Product } from "../../data/products";

interface Props {
  product: Product;
  size?: number;
  class?: string;
}
const { product, size = 44, class: className } = Astro.props;
---

<span
  class:list={["picon", className]}
  style={`--acc:${product.accent};--s:${size}px`}
  aria-hidden="true"
>
  <Icon name={product.icon} size={Math.round(size * 0.5)} />
</span>

<style>
  .picon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.28);
    color: #fff;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.22), transparent 55%),
      var(--acc);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 6px 16px -6px color-mix(in srgb, var(--acc) 70%, transparent);
  }
</style>
